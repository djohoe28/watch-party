rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users can list a room's messages,
    // but can only read or write a message if they are a member of the room
    // (write additionally requires the message's senderId to match the caller).
    match /rooms/{roomName}/messages/{message} {
    	allow read: if request.auth != null && exists(/databases/$(database)/documents/rooms/$(roomName)/members/$(request.auth.uid));
      allow write: if request.auth != null && request.resource.data.senderId == request.auth.uid && exists(/databases/$(database)/documents/rooms/$(roomName)/members/$(request.auth.uid));
    }
    match /rooms/{roomName}/members/{member} {
    	allow read: if request.auth != null;
    	allow write: if request.auth != null && request.auth.uid == member;
    }
    match /rooms/{roomName}/members {
    	allow read: if request.auth != null;
    }
    // Authenticated users can read & create room data,
    // but can only write if they are a member of the room.
    match /rooms/{roomName} {
    	allow read, create: if request.auth != null;
    	allow write: if request.auth != null && exists(/databases/$(database)/documents/rooms/$(roomName)/members/$(request.auth.uid));
    }
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}